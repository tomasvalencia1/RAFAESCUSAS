{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "avatar": {
          ".validate": "newData.isString() && (newData.val() === data.val() || newData.val() === '' || (newData.val().length <= 20000 && (newData.val().beginsWith('data:image/jpeg;base64,') || newData.val().beginsWith('https://lh3.googleusercontent.com/') || newData.val().beginsWith('https://lh4.googleusercontent.com/') || newData.val().beginsWith('https://lh5.googleusercontent.com/') || newData.val().beginsWith('https://lh6.googleusercontent.com/'))))"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'estudiante' || root.child('admins').child(auth.uid).val() === true)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "roleRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.child('requestedRole').val() !== 'estudiante' && newData.child('status').val() === 'pending') || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "posts": {
      ".indexOn": [
        "createdAt",
        "timestamp"
      ],
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('author').child('uid').val() === auth.uid && newData.child('authorRole').val() === root.child('users').child(auth.uid).child('role').val()) || (data.exists() && !newData.exists() && (data.child('author').child('uid').val() === auth.uid || data.child('autorId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)) || (data.exists() && newData.exists() && root.child('admins').child(auth.uid).val() === true))",
        ".validate": "data.exists() || !newData.exists() || (newData.hasChildren(['author', 'authorRole', 'timestamp', 'createdAt']) && newData.child('createdAt').val() <= now + 60000 && newData.child('timestamp').val() <= now + 60000 && !newData.child('likes').exists() && !newData.child('comentarios').exists() && !newData.child('comments').exists())",
        "author": {
          ".validate": "newData.hasChildren(['uid'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 20000"
          },
          "$otro": {
            ".validate": false
          }
        },
        "authorRole": {
          ".validate": "newData.isString()"
        },
        "content": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "flagged": {
          ".validate": "newData.isBoolean()"
        },
        "reason": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "tieneImagen": {
          ".validate": "newData.isBoolean()"
        },
        "imageBase64": {
          ".validate": false
        },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        },
        "comentarios": {
          "$commentId": {
            ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('autorId').val() === auth.uid && (data.parent().parent().child('authorRole').val() !== 'estudiante' || now < data.parent().parent().child('createdAt').val() + 86400000)) || (data.exists() && !newData.exists() && root.child('admins').child(auth.uid).val() === true))",
            ".validate": "!newData.exists() || (newData.hasChildren(['autorId', 'autorNombre', 'texto', 'timestamp']) && newData.child('autorId').val() === auth.uid && newData.child('texto').isString() && newData.child('texto').val().length >= 1 && newData.child('texto').val().length <= 500 && newData.child('timestamp').isNumber() && newData.child('timestamp').val() <= now + 60000 && newData.child('autorNombre').isString() && newData.child('autorNombre').val().length <= 60 && (!newData.child('autorAvatar').exists() || (newData.child('autorAvatar').isString() && newData.child('autorAvatar').val().length <= 20000)))"
          }
        },
        "comments": {
          "$commentId": {
            ".write": "auth != null && data.exists() && !newData.exists() && root.child('admins').child(auth.uid).val() === true"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "siguiendo": {
      "$seguidorId": {
        ".read": "auth != null && auth.uid === $seguidorId",
        "$seguidoId": {
          ".write": "auth != null && auth.uid === $seguidorId && (newData.val() === null || (newData.child('seguidoId').val() === $seguidoId && newData.child('creadoEn').isNumber()))"
        }
      }
    },
    "mensajes_profesor": {
      ".read": "auth != null",
      "$dia": {
        "$profesorId": {
          "$slot": {
            ".write": "auth != null && ((auth.uid === $profesorId && (root.child('users').child(auth.uid).child('role').val() === 'profesor' || root.child('users').child(auth.uid).child('role').val() === 'maestro' || root.child('admins').child(auth.uid).val() === true) && !data.exists() && newData.exists() && ($slot === '1' || $slot === '2' || $slot === '3')) || (root.child('admins').child(auth.uid).val() === true && data.exists() && !newData.exists()))",
            ".validate": "newData.hasChildren(['autorId', 'autorNombre', 'texto', 'timestamp', 'dia']) && newData.child('autorId').val() === auth.uid && newData.child('autorNombre').isString() && newData.child('texto').isString() && newData.child('texto').val().length <= 180 && newData.child('timestamp').isNumber() && newData.child('dia').val() === $dia"
          }
        }
      }
    },
    "logs_moderacion": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$logId": {
        ".write": "auth != null && !data.exists() && newData.exists() && root.child('admins').child(auth.uid).val() === true && newData.child('moderadorId').val() === auth.uid",
        ".validate": "newData.hasChildren(['moderadorId', 'postId', 'accion', 'timestamp']) && newData.child('postId').isString() && newData.child('timestamp').isNumber()"
      }
    },
    "soporte": {
      ".indexOn": [
        "timestamp",
        "resueltoEn"
      ],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$ticketId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'directivo')",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid && newData.child('texto').isString() && newData.child('texto').val().length <= 1000 && newData.child('estado').val() === 'pendiente') || (data.exists() && (root.child('users').child(auth.uid).child('role').val() === 'directivo' || root.child('admins').child(auth.uid).val() === true)))"
      }
    },
    "configuracion": {
      "moderacion": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "news": {
      ".indexOn": [
        "timestamp"
      ],
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "reports": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "events": {
      ".indexOn": [
        "timestamp"
      ],
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "personalTasks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chats": {
      ".indexOn": [
        "lastTimestamp"
      ],
      "$chatId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
        "participants": {
          ".write": "auth != null && !data.exists() && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && (root.child('users').child(auth.uid).child('role').val() === 'maestro' || root.child('users').child(auth.uid).child('role').val() === 'profesor' || root.child('users').child(auth.uid).child('role').val() === 'padre' || root.child('users').child(auth.uid).child('role').val() === 'acudiente' || root.child('users').child(auth.uid).child('role').val() === 'directivo' || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.child(auth.uid).val() === true",
          "$uid": {
            ".validate": "newData.val() === true && ($chatId.beginsWith($uid + '_') || $chatId.endsWith('_' + $uid)) && (root.child('users').child($uid).child('role').val() === 'maestro' || root.child('users').child($uid).child('role').val() === 'profesor' || root.child('users').child($uid).child('role').val() === 'padre' || root.child('users').child($uid).child('role').val() === 'acudiente' || root.child('users').child($uid).child('role').val() === 'directivo' || root.child('admins').child($uid).val() === true)"
          }
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['senderId', 'text', 'timestamp']) && newData.child('senderId').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 1000 && newData.child('timestamp').isNumber() && newData.child('timestamp').val() <= now + 60000",
            "senderName": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "sender": {
              ".validate": "newData.val() === auth.uid"
            },
            "senderRole": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            }
          }
        },
        "lastMessage": {
          ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "lastTimestamp": {
          ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    },
    "privado": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "imagenesPosts": {
      "$postId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && !root.child('posts').child($postId).exists() && newData.parent().parent().child('posts').child($postId).child('author').child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (root.child('posts').child($postId).child('author').child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || !newData.parent().parent().child('posts').child($postId).exists())))",
        ".validate": "newData.isString() && newData.val().length <= 300000 && newData.val().beginsWith('data:image/jpeg;base64,')"
      }
    }
  }
}
